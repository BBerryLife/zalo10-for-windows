<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="zalo10_for_windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:zalo10_for_windows"
    xmlns:views="using:zalo10_for_windows.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Zalo10">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" Loaded="Root_Loaded">
        <StackPanel x:Name="LoginPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Width="340">
            <TextBlock Text="Đăng nhập Zalo bằng mã QR" FontSize="22" HorizontalAlignment="Center"/>

            <Grid Width="280" Height="280" HorizontalAlignment="Center">
                <Image x:Name="QrImage"/>
                <ProgressRing x:Name="Busy" IsActive="True" Width="48" Height="48"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <TextBlock x:Name="StatusText" Text="Đang kết nối tới Zalo..." TextWrapping="Wrap"
                       TextAlignment="Center" HorizontalAlignment="Center"/>
        </StackPanel>

        <views:MainShell x:Name="Shell" Visibility="Collapsed"/>
    </Grid>
</Window>
