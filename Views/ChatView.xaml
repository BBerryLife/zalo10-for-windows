<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="zalo10_for_windows.Views.ChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:zalo10_for_windows.Views">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="Auto"/>   <!-- note -->
            <RowDefinition Height="*"/>      <!-- messages -->
            <RowDefinition Height="Auto"/>   <!-- send status -->
            <RowDefinition Height="Auto"/>   <!-- input -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="16,10" ColumnSpacing="12"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <PersonPicture x:Name="HeaderAvatar" Grid.Column="0" Width="40" Height="40"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Note (for example: 1-1 history is not available yet) -->
        <Border x:Name="NoteBar" Grid.Row="1" Visibility="Collapsed" Padding="16,8" Background="#26FFB300">
            <TextBlock x:Name="NoteText" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <!-- Messages -->
        <Grid Grid.Row="2" Background="#14808A9B">
            <ListView x:Name="MessageList" ItemsSource="{x:Bind Messages}" SelectionMode="None"
                      IsItemClickEnabled="False">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="views:MessageItem">
                        <Grid Padding="16,3">
                            <Border HorizontalAlignment="{x:Bind Align}" Background="{x:Bind BubbleBrush}"
                                    CornerRadius="8" Padding="12,8" MaxWidth="460">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind Sender}" Visibility="{x:Bind SenderVisibility}"
                                               FontSize="12" Foreground="#5F6B7A"/>
                                    <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" FontSize="15"
                                               IsTextSelectionEnabled="True" Foreground="#1A1A1A"/>
                                    <TextBlock Text="{x:Bind TimeText}" FontSize="11" Foreground="#6B7684"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="InfoText" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="24"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>

        <!-- Send error -->
        <TextBlock x:Name="StatusBar" Grid.Row="3" Padding="16,4" FontSize="12" Foreground="#D13438"
                   Visibility="Collapsed"/>

        <!-- Input: one wide rounded bar with the icons inside it.
             Order: attach | text | send | timed message | emoticon. The icons are white masks tinted with the theme colour. -->
        <Grid Grid.Row="4" Padding="12,10"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Border CornerRadius="10" Padding="4,2"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                <Button Grid.Column="0" VerticalAlignment="Bottom" Width="48" Height="48" Padding="0"
                        Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Đính kèm (chưa hỗ trợ)">
                    <BitmapIcon UriSource="ms-appx:///Assets/Icons/ic_attach.png" ShowAsMonochrome="True" Width="32" Height="32"/>
                </Button>
                    <TextBox x:Name="InputBox" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap"
                             MaxHeight="120" VerticalAlignment="Bottom" FontSize="15" Margin="0,0,0,6"
                             Background="Transparent" BorderThickness="0" PreviewKeyDown="InputBox_PreviewKeyDown">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                        </TextBox.Resources>
                    </TextBox>
                <Button Grid.Column="2" VerticalAlignment="Bottom" Width="48" Height="48" Padding="0"
                        Background="Transparent" BorderThickness="0" Click="Send_Click" ToolTipService.ToolTip="Gửi (Enter)">
                    <BitmapIcon UriSource="ms-appx:///Assets/Icons/ic_send.png" ShowAsMonochrome="True" Width="32" Height="32" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                </Button>
                <Button Grid.Column="3" VerticalAlignment="Bottom" Width="48" Height="48" Padding="0"
                        Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Tin nhắn hẹn giờ (chưa hỗ trợ)">
                    <BitmapIcon UriSource="ms-appx:///Assets/Icons/ic_timemess.png" ShowAsMonochrome="True" Width="32" Height="32"/>
                </Button>
                <Button Grid.Column="4" VerticalAlignment="Bottom" Width="48" Height="48" Padding="0"
                        Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Biểu tượng cảm xúc (chưa hỗ trợ)">
                    <BitmapIcon UriSource="ms-appx:///Assets/Icons/ic_emoticon.png" ShowAsMonochrome="True" Width="32" Height="32"/>
                </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
